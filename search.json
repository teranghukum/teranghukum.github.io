---
layout: null
---
[
{%- assign items = site.pages | concat: site.posts -%}
{%- for item in items -%}
  {%- if item.title and item.url != '/search.json' -%}
  {"title": {{ item.title | jsonify }}, "url": {{ item.url | relative_url | jsonify }}, "bidang": {{ item.bidang | jsonify }}, "jenis": {{ item.jenis | jsonify }}}{% unless forloop.last %},{% endunless %}
  {%- endif -%}
{%- endfor -%}
]
